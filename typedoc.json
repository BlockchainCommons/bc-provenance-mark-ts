{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "out": "docs",
  "name": "@blockchaincommons/provenance-mark",
  "includeVersion": true,
  "readme": "README.md",
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/tests/**",
    "**/node_modules/**"
  ],
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": false,
  "skipErrorChecking": false,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "categorizeByGroup": true,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Core CBOR",
    "Encoding/Decoding",
    "Data Structures",
    "Tagged Values",
    "Utilities",
    "*"
  ],
  "sort": [
    "source-order"
  ],
  "kindSortOrder": [
    "Function",
    "Class",
    "Interface",
    "TypeAlias",
    "Variable",
    "Enum"
  ],
  "visibilityFilters": {
    "protected": false,
    "private": false,
    "inherited": true,
    "external": false
  },
  "searchInComments": true,
  "cleanOutputDir": true,
  "plugin": [],
  "highlightLanguages": [
    "typescript",
    "javascript",
    "json",
    "rust",
    "bash",
    "shell",
    "tsx",
    "jsx"
  ],
  "externalSymbolLinkMappings": {
    "@blockchaincommons/uniform-resources": {
      "UR": "https://blockchaincommons.github.io/bc-ur-ts/classes/UR.html",
      "UREncodable": "https://blockchaincommons.github.io/bc-ur-ts/interfaces/UREncodable.html"
    }
  }
}
